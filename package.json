{
	"name": "folder-notes",
	"version": "1.8.26",
	"description": "Create notes within folders that can be accessed without collapsing the folder, similar to the functionality offered in Notion.",
	"main": "dist/main.js",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "bun esbuild.config.mjs production",
		"build:css": "bun x sass src/frontend/styles/main.scss public/styles.css --no-source-map",
		"package": "bun scripts/package.mjs",
		"version:patch": "bun scripts/version-bump.mjs patch",
		"version:minor": "bun scripts/version-bump.mjs minor",
		"version:major": "bun scripts/version-bump.mjs major",
		"test": "bun test --preload ./tests/obsidian_mock.ts",
		"test:all": "bun test --preload ./tests/obsidian_mock.ts",
		"fn-dev": "node esbuild.config.mjs",
		"fn-build": "node esbuild.config.mjs production",
		"version": "node scripts/version-bump.mjs patch"
	},

	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"folder-notes",
		"notes",
		"file-tree"
	],
	"author": "Lost Paul",
	"license": "GPL-3.0-or-later",
	"devDependencies": {
		"@eslint/js": "^8.57.1",
		"@types/node": "^26.4.1",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.24.0",
		"eslint": "^10.4.1",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"front-matter-plugin-api-provider": "^0.1.4-alpha",
		"globals": "^16.3.0",
		"jiti": "^2.5.1",
		"obsidian": "latest",
		"obsidian-typings": "^2.2.0",
		"sass": "^1.103.1",
		"tslib": "^2.7.0",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.38.0"
	}
}
